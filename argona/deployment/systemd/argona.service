[Unit]
Description=ARGONA prediction-market intelligence & trading system
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=argona
Group=argona
WorkingDirectory=/opt/argona
EnvironmentFile=/opt/argona/.env
ExecStartPre=/opt/argona/.venv/bin/argona migrate
ExecStart=/opt/argona/.venv/bin/argona serve
Restart=always
RestartSec=5
TimeoutStopSec=35
KillSignal=SIGTERM
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/argona/data
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
