# ============================================================================
# ZigGgy configuration. Copy to .env (never commit .env). Defaults are safe:
# paper trading only, live trading disabled, loopback-only API.
# ============================================================================

# --- server ---
ZIGGGY_HOST=127.0.0.1             # use 0.0.0.0 only behind a reverse proxy AND with ZIGGGY_API_TOKEN set
ZIGGGY_PORT=8000
ZIGGGY_API_TOKEN=                 # generate: zigggy gen-token  (required for any non-loopback access)
ZIGGGY_LOG_LEVEL=INFO
ZIGGGY_LOG_JSON=true
ZIGGGY_DATA_DIR=./data
# ZIGGGY_DATABASE_URL=postgresql+asyncpg://zigggy:change-me@postgres:5432/zigggy   # optional; default SQLite in data dir
ZIGGGY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- market data providers: polymarket, kalshi, sim (sim = clearly labelled simulated venue) ---
ZIGGGY_PROVIDERS=polymarket,kalshi
ZIGGGY_POLYMARKET_MAX_MARKETS=1500
ZIGGGY_KALSHI_MAX_MARKETS=3000
ZIGGGY_KALSHI_SERIES=             # optional: restrict discovery, e.g. KXHIGHNY,KXHIGHCHI,KXBTCD
ZIGGGY_MAX_BOOKS_PER_CYCLE=60
ZIGGGY_POLYMARKET_RPS=8           # client-side request rate limits (token bucket)
ZIGGGY_KALSHI_RPS=8

# --- scheduler intervals (seconds) ---
ZIGGGY_DISCOVERY_INTERVAL_S=600
ZIGGGY_SCAN_INTERVAL_S=45
ZIGGGY_ORDER_MONITOR_INTERVAL_S=10
ZIGGGY_SETTLEMENT_INTERVAL_S=180
ZIGGGY_SNAPSHOT_INTERVAL_S=60

# --- paper trading ---
ZIGGGY_PAPER_STARTING_CAPITAL=10000
ZIGGGY_START_MODE=PAPER           # first-run mode: PAPER or STOPPED (LIVE can never be a start mode)

# --- LIVE trading (real money). Leave disabled unless you have read docs/OPERATIONS.md §Live ---
ZIGGGY_LIVE_TRADING_ENABLED=false
ZIGGGY_LIVE_RESUME_ON_RESTART=false
# Kalshi API key (trading-only permissions). Private key file path, e.g. ./secrets/kalshi.pem (docker: /secrets/kalshi.pem)
ZIGGGY_KALSHI_KEY_ID=
ZIGGGY_KALSHI_PRIVATE_KEY_PATH=
# ZIGGGY_KALSHI_API_URL=https://demo-api.kalshi.co/trade-api/v2   # Kalshi demo environment for sandbox testing
# Polymarket: EVM private key of a dedicated trading wallet (needs: pip install 'zigggy[polymarket-live]')
ZIGGGY_POLYMARKET_PRIVATE_KEY=
ZIGGGY_POLYMARKET_WALLET=

# --- optional LLM rules review (flags ambiguous resolution criteria; never sets prices) ---
ZIGGGY_LLM_PROVIDER=none          # none | anthropic
ZIGGGY_ANTHROPIC_API_KEY=
ZIGGGY_LLM_MODEL=claude-opus-5-5
ZIGGGY_LLM_MAX_REVIEWS_PER_HOUR=20

# --- notifications ---
ZIGGGY_TELEGRAM_BOT_TOKEN=
ZIGGGY_TELEGRAM_CHAT_ID=
ZIGGGY_SMTP_HOST=
ZIGGGY_SMTP_PORT=587
ZIGGGY_SMTP_USER=
ZIGGGY_SMTP_PASSWORD=
ZIGGGY_SMTP_FROM=
ZIGGGY_SMTP_TO=

# --- docker compose extras ---
ZIGGGY_PUBLISH_PORT=8000
ZIGGGY_DOMAIN=                    # for the https profile (Caddy)
POSTGRES_PASSWORD=change-me
