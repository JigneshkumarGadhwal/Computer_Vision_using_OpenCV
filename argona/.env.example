# ============================================================================
# ARGONA configuration. Copy to .env (never commit .env). Defaults are safe:
# paper trading only, live trading disabled, loopback-only API.
# ============================================================================

# --- server ---
ARGONA_HOST=127.0.0.1             # use 0.0.0.0 only behind a reverse proxy AND with ARGONA_API_TOKEN set
ARGONA_PORT=8000
ARGONA_API_TOKEN=                 # generate: argona gen-token  (required for any non-loopback access)
ARGONA_LOG_LEVEL=INFO
ARGONA_LOG_JSON=true
ARGONA_DATA_DIR=./data
# ARGONA_DATABASE_URL=postgresql+asyncpg://argona:change-me@postgres:5432/argona   # optional; default SQLite in data dir
ARGONA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- market data providers: polymarket, kalshi, sim (sim = clearly labelled simulated venue) ---
ARGONA_PROVIDERS=polymarket,kalshi
ARGONA_POLYMARKET_MAX_MARKETS=1500
ARGONA_KALSHI_MAX_MARKETS=3000
ARGONA_KALSHI_SERIES=             # optional: restrict discovery, e.g. KXHIGHNY,KXHIGHCHI,KXBTCD
ARGONA_MAX_BOOKS_PER_CYCLE=60

# --- scheduler intervals (seconds) ---
ARGONA_DISCOVERY_INTERVAL_S=600
ARGONA_SCAN_INTERVAL_S=45
ARGONA_ORDER_MONITOR_INTERVAL_S=10
ARGONA_SETTLEMENT_INTERVAL_S=180
ARGONA_SNAPSHOT_INTERVAL_S=60

# --- paper trading ---
ARGONA_PAPER_STARTING_CAPITAL=10000
ARGONA_START_MODE=PAPER           # first-run mode: PAPER or STOPPED (LIVE can never be a start mode)

# --- LIVE trading (real money). Leave disabled unless you have read docs/OPERATIONS.md §Live ---
ARGONA_LIVE_TRADING_ENABLED=false
ARGONA_LIVE_RESUME_ON_RESTART=false
# Kalshi API key (trading-only permissions). Private key file path, e.g. ./secrets/kalshi.pem (docker: /secrets/kalshi.pem)
ARGONA_KALSHI_KEY_ID=
ARGONA_KALSHI_PRIVATE_KEY_PATH=
# ARGONA_KALSHI_API_URL=https://demo-api.kalshi.co/trade-api/v2   # Kalshi demo environment for sandbox testing
# Polymarket: EVM private key of a dedicated trading wallet (needs: pip install 'argona[polymarket-live]')
ARGONA_POLYMARKET_PRIVATE_KEY=
ARGONA_POLYMARKET_WALLET=

# --- optional LLM rules review (flags ambiguous resolution criteria; never sets prices) ---
ARGONA_LLM_PROVIDER=none          # none | anthropic
ARGONA_ANTHROPIC_API_KEY=
ARGONA_LLM_MODEL=claude-opus-5-5
ARGONA_LLM_MAX_REVIEWS_PER_HOUR=20

# --- notifications ---
ARGONA_TELEGRAM_BOT_TOKEN=
ARGONA_TELEGRAM_CHAT_ID=
ARGONA_SMTP_HOST=
ARGONA_SMTP_PORT=587
ARGONA_SMTP_USER=
ARGONA_SMTP_PASSWORD=
ARGONA_SMTP_FROM=
ARGONA_SMTP_TO=

# --- docker compose extras ---
ARGONA_PUBLISH_PORT=8000
ARGONA_DOMAIN=                    # for the https profile (Caddy)
POSTGRES_PASSWORD=change-me
