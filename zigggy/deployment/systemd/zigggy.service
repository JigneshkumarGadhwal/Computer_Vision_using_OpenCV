[Unit]
Description=ZigGgy prediction-market intelligence & trading system
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zigggy
Group=zigggy
WorkingDirectory=/opt/zigggy
EnvironmentFile=/opt/zigggy/.env
ExecStartPre=/opt/zigggy/.venv/bin/zigggy migrate
ExecStart=/opt/zigggy/.venv/bin/zigggy serve
Restart=always
RestartSec=5
TimeoutStopSec=35
KillSignal=SIGTERM
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/zigggy/data
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
