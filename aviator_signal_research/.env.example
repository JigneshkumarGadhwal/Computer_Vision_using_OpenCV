# Copy to .env and adjust. No secrets are required by this application.
# Database (SQLite default; PostgreSQL example below)
AVR_DATABASE_URL=sqlite:///./data/aviator_research.db
# AVR_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/aviator_research
AVR_RAW_DATA_DIR=./data/raw
AVR_MODEL_DIR=./data/models
AVR_REPORT_DIR=./reports
# Reference distribution P(X>=m) = RTP/m (UNVERIFIED assumption; set from operator documentation)
AVR_REFERENCE_RTP=0.97
# Thresholds evaluated by default and the primary one
AVR_THRESHOLDS=1.5,2,3,5
AVR_PRIMARY_THRESHOLD=2
# Live feed is stale (signals disabled) after this many seconds without a new round
AVR_STALE_AFTER_SECONDS=120
AVR_MAX_VALID_MULTIPLIER=1000000
AVR_SUSPICIOUS_REPEAT_RUN=5
AVR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
